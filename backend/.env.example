APP_NAME=ChargeShare API
ENVIRONMENT=development
# SQLite is used by default for a zero-setup local demo. For PostgreSQL, uncomment and set credentials:
DATABASE_URL=sqlite:///./chargeshare.db
JWT_SECRET_KEY=replace-this-with-a-long-random-secret-before-use
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
